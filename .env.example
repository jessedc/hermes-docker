# Copy to ".env" in the same folder as docker-compose.yml, then edit.
# Docker Compose reads this file automatically. It is NOT passed into the
# container wholesale — only the variables referenced in docker-compose.yml.

# --- Host user that owns the data folder ------------------------------------
# SSH into the NAS and run `id`. Do not guess: if these are wrong the
# container will not be able to write to /opt/data.
PUID=1026
PGID=100

# --- Where Hermes keeps its state -------------------------------------------
# Must be an absolute path on the NAS. Adjust if your volume is not volume1.
HERMES_DATA=/volume1/docker/hermes/data

TZ=UTC

# --- Dashboard login (required) ---------------------------------------------
DASHBOARD_USER=admin
# Use something long. openssl rand -base64 24
DASHBOARD_PASS=CHANGE_ME
# Signs dashboard session cookies so logins survive a restart.
# openssl rand -hex 32
DASHBOARD_SECRET=CHANGE_ME

# --- Upstream inference endpoint credentials --------------------------------
# The bearer token your tailnet OpenAI-compatible server expects.
# Use "none" for vLLM / llama.cpp / Ollama with no auth.
# Referenced from config.yaml as ${LLM_API_KEY}.
LLM_API_KEY=none

# --- Port publishing --------------------------------------------------------
# 0.0.0.0 publishes on every NAS interface. Set this to the NAS's Tailscale
# address (100.x.y.z) to make the dashboard reachable over the tailnet only.
BIND_ADDR=0.0.0.0

# --- Resource ceilings ------------------------------------------------------
# Lower these on a 4 GB NAS, e.g. MEM_LIMIT=2G and CPU_LIMIT=1.0
MEM_LIMIT=4G
CPU_LIMIT=2.0

# --- Only needed if you enable Hermes' own API server -----------------------
# Minimum 8 characters; 32+ recommended. openssl rand -hex 32
# API_SERVER_KEY=
