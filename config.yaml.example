# ---------------------------------------------------------------------------
# Hermes Agent configuration
#
# Copy this to  <HERMES_DATA>/config.yaml  (e.g. /volume1/docker/hermes/data/
# config.yaml) BEFORE the first start. Doing so skips the interactive `hermes
# setup` wizard, which is awkward to run from Container Manager.
#
# Rule from the Hermes docs: secrets live in .env, everything else lives here.
# ${VAR} placeholders are substituted from the environment ($VAR is not).
#
# HEADS UP: this file is machine-managed. Changing settings in the dashboard
# (or via `hermes config set`) rewrites it — comments are stripped, keys are
# reordered and renamed to their canonical form, and keys the writer does not
# round-trip are dropped. Treat it as seed state, not a document you maintain.
# ---------------------------------------------------------------------------

model:
  # "custom" = any OpenAI-compatible /v1 endpoint.
  provider: "custom"

  # The machine on your tailnet running llama.cpp / vLLM / LM Studio /
  # LiteLLM / TabbyAPI — here, the DGX Spark serving llama.cpp on :8080. Use
  # the raw 100.x.y.z Tailscale address — MagicDNS names do not resolve inside
  # Synology containers unless you add an extra_hosts entry in
  # docker-compose.yml.
  #
  # The path almost always ends in /v1.
  base_url: "http://100.x.y.z:8080/v1"

  # The main model. Check what the server has loaded with:
  #   curl -s http://100.x.y.z:8080/v1/models | jq -r '.data[].id'
  #
  # llama.cpp reports the id as the full HF cache path and ignores the "model"
  # field entirely when only one model is loaded, so a short readable alias
  # works and is what this repo uses. vLLM and LiteLLM do NOT ignore it — there
  # the id must match exactly what /v1/models prints.
  #
  # The key is "default", NOT "model". Hermes accepts "model:" on read, but
  # "default" is the canonical name it persists, what the dashboard's "Main
  # Model" selector writes, and what `hermes config get model.default` reads.
  # Seeding "model:" leaves the dashboard showing no main model selected.
  default: "DeepSeek-V4-Flash-0731-UD-IQ2_M"

  # Injected from docker-compose.yml. Set LLM_API_KEY=none in .env for a
  # server that does not check the bearer token.
  api_key: "${LLM_API_KEY}"

  # Many self-hosted servers do not advertise their context window. Set it
  # explicitly to whatever you launched the server with, otherwise Hermes
  # cannot size its compression correctly. llama.cpp does report it:
  #   curl -s http://100.x.y.z:8080/v1/models | jq '.data[].meta.n_ctx'
  #
  # Note: the dashboard drops this key when it rewrites the file after a
  # "Main Model" change. Re-check it with
  #   hermes config get model.context_length
  # after using the UI, and re-add it if it has gone missing.
  context_length: 262144

# Side tasks: vision, context compression, web page extraction, session
# titles. "auto" reuses the main model above, which is what you want when
# there is only one endpoint on the tailnet.
#
# Vision is the one worth checking. "auto" only routes images to the main model
# if Hermes believes that model is vision-capable, and a locally-served GGUF
# carries no capability metadata for it to consult. Ask the server directly:
#   curl -s http://100.x.y.z:8080/props | jq '.modalities'
#
# DeepSeek V4 Flash is text-only, so there is nothing to route images to while
# it is the loaded model and "auto" is the honest setting. Swap in a multimodal
# GGUF and the server reports "vision": true — then name the model explicitly
# rather than leaving it on "auto":
#
#   vision:
#     provider: "custom"
#     model: "same id as model.default above"
#     base_url: "http://100.x.y.z:8080/v1"
#     api_key: "${LLM_API_KEY}"
#     timeout: 180
auxiliary:
  vision:
    provider: "auto"
  compression:
    provider: "auto"
    timeout: 120
  web_extract:
    provider: "auto"
    timeout: 360
  title_generation:
    enabled: true
    provider: "auto"
    timeout: 30

agent:
  max_turns: 500
  api_max_retries: 3
  # reasoning_effort is deliberately UNSET, which is not the same as "none".
  #
  # With provider: "custom" Hermes emits the level as a TOP-LEVEL
  # `reasoning_effort` field (not extra_body.reasoning — that is the OpenRouter
  # shape, and Hermes suppresses it for any non-OpenRouter base_url). llama.cpp
  # ignores that field for every value EXCEPT "none", which it special-cases
  # into thinking-off. So "none" is a real switch and minimal/low/medium/high
  # are dead letters on this route.
  #
  # Check it yourself — llama.cpp renders the prompt without running the model,
  # so this costs no GPU time. Note /apply-template sits at the root, not
  # under /v1:
  #   U=http://100.x.y.z:8080/apply-template
  #   M='"messages":[{"role":"user","content":"hi"}]'
  #   curl -s $U -d "{$M}"                             | jq -r .prompt | wc -c
  #   curl -s $U -d "{$M,\"reasoning_effort\":\"high\"}" | jq -r .prompt | wc -c
  #
  # Identical byte counts mean the field never reached the template. On
  # b1-ba360efe1 with DeepSeek V4 Flash both print 68; "none" prints 69, and
  # that one byte is the whole difference between a switch and a dead letter.
  #
  # The model's template compounds this: it branches on 'high' and 'max' only,
  # so "medium" injects nothing even through a channel that does work. And
  # thinking is already ON by default (llama.cpp passes enable_thinking=true),
  # so leaving this key out IS the middle setting.
  #
  # To genuinely raise it, use chat_template_kwargs via a providers entry —
  # this merges into the request body rather than replacing what the profile
  # already put there:
  #
  #   providers:
  #     spark:
  #       base_url: "http://100.x.y.z:8080/v1"
  #       extra_body:
  #         chat_template_kwargs: {thinking: true, reasoning_effort: high}
  #
  # Costly here, and more so than on the minimal deployment: total_slots is 1
  # so thinking serialises across turns, the server's reasoning_format is
  # "none" so <think> arrives inline in content (Hermes strips it, but the
  # tokens still count against compression.threshold), and max_turns is 500
  # above. Never combine it with reasoning_effort: "none" — the two contradict
  # each other on the wire.

# Shell commands run inside this container, under the PUID/PGID you set.
# They can see /opt/data and nothing else of the NAS unless you mount more.
terminal:
  backend: "local"
  cwd: "/opt/data"
  timeout: 180
  persistent_shell: true

memory:
  memory_enabled: true
  user_profile_enabled: true

# Self-hosted endpoints are usually slower and smaller than hosted APIs, so
# compressing earlier than the default keeps sessions responsive.
compression:
  enabled: true
  threshold: 0.50
  target_ratio: 0.20
  protect_last_n: 20

# MCP servers. Prefer `hermes mcp add <name> --url <endpoint>` over hand-editing
# this — it probes the endpoint, lists the tools it found, and writes the entry
# only after a successful connection. The result looks like the block below.
#
# The URL is resolved from INSIDE the Hermes container, which is what makes the
# NAS case counter-intuitive. If the MCP server is another container on the same
# NAS, do NOT route back out through its published host port or its tailnet
# name — join its Docker network and address it by container name on its
# INTERNAL port. See "MCP servers" in the README for why the tailnet route
# cannot work from the NAS.
#
# mcp_servers:
#   brave-search:
#     url: "http://brave-search-mcp:8080/mcp"
#     enabled: true

updates:
  # `hermes update` is unsupported in Docker; you update by pulling the image.
  pre_update_backup: "quick"
  backup_keep: 5
