# ---------------------------------------------------------------------------
# Hermes Agent — MINIMAL configuration
#
# Copy to  <HERMES_DATA>/config.yaml  BEFORE the first start.
#
# Three capabilities and nothing else: the local model, one MCP server, and
# Telegram. Everything else is off. Expand deliberately — see "Expanding" in
# the README.
#
# PORTABLE BY DESIGN: every host-specific value is a ${VAR} read from the
# container environment, so this exact file runs on the Mac and on the NAS.
# Only .env differs.
#
# HEADS UP: this file is machine-managed. The dashboard and `hermes config set`
# rewrite it — comments stripped, keys reordered. ${VAR} placeholders ARE
# preserved verbatim through a rewrite. Treat it as seed state.
# ---------------------------------------------------------------------------

model:
  provider: custom
  base_url: "${LLM_BASE_URL}"
  default: "${LLM_MODEL}"
  api_key: "${LLM_API_KEY}"
  # From the server's own n_ctx, not the model's architectural maximum:
  #   curl -s $LLM_BASE_URL/models | jq '.data[].meta.n_ctx'
  context_length: 262144

# All "auto" — they follow the main model. Nothing routes anywhere else.
auxiliary:
  vision: {provider: auto}
  compression: {provider: auto, timeout: 120}
  web_extract: {provider: auto, timeout: 360}
  title_generation: {enabled: true, provider: auto, timeout: 30}

agent:
  # Deliberately far below the stock 500. This box runs unattended; a runaway
  # loop should stop on its own rather than grind the inference server for an
  # afternoon. Raise it when you have a task that genuinely needs the turns.
  max_turns: 40
  api_max_retries: 3
  # reasoning_effort is deliberately UNSET, which is not the same as `none`.
  #
  # provider: custom emits this as a top-level `reasoning_effort` field, and on
  # the llama.cpp route only "none" does anything — it switches thinking off.
  # `low`/`medium`/`high` are dead letters. Thinking is on by default, so
  # omitting the key IS the middle setting.
  #
  # To actually raise it, use chat_template_kwargs — see "Reasoning" in the
  # README.
  #
  # `clarify` blocks the session thread until the user answers. Stock is 3600.
  # Half an hour is long enough for someone who stepped away, short enough
  # that a question nobody saw doesn't pin a worker for an hour. <= 0 means
  # wait forever.
  clarify_timeout: 1800

# ── The allowlist ─────────────────────────────────────────────────────────
# This is the whole point of the minimal setup. Only toolsets named here are
# enabled; everything else is off, per platform. Three tools cost 6,625 B of
# schema against 55,460 B for the stock set.
#
# Marginal cost of each (`hermes prompt-size`, one toolset at a time):
#
#   memory     2,833 B  +1,442 B system   the reason it's worth talking to twice
#   clarify    2,414 B         no system  one round-trip beats a wrong 40-turn run
#   todo       1,372 B         no system  keeps a low-effort model on plan
#
# clarify and todo are the two cheapest entries in the catalogue that change
# how the agent behaves rather than what it can reach, and neither adds a byte
# to the system prompt — unlike `skills` (+9,818 B of always-on index) or
# `memory` itself. On Telegram the adapter renders clarify as real inline
# buttons; under `hermes -z` there is no callback to answer it, so the tool
# returns an error instead of hanging a scripted run.
#
# Deliberately NOT here: `session_search` (6,457 B for a single tool — it would
# double the schema budget, and on day one there is no history to search) and
# `file` (6,670 B). See "Expanding" in the README for the cost of every other
# toolset.
#
# Add to BOTH lists when expanding, or the capability appears in one surface
# and not the other. Equivalent CLI:
#   hermes tools enable file --platform telegram
platform_toolsets:
  cli: [clarify, memory, todo]
  telegram: [clarify, memory, todo]

# ── Why this block matters ────────────────────────────────────────────────
# Hermes treats a toolset it has never seen as NEW and enables it by default,
# so a toolset missing from platform_toolsets above can still come up enabled
# — that is how an image update that adds toolsets would silently re-expand
# the agent.
#
# Seeding the known set closes that door. These 27 names are what `hermes
# tools` writes here after a save, i.e. the toolsets its picker can offer.
# Re-check after a major image update with `hermes tools list`; a genuinely
# new toolset will not be in this list yet.
#
# `kanban` is deliberately absent: it is check_fn-gated and non-configurable,
# so it resolves in on every platform no matter what either list says, and
# ships zero tool schemas unless kanban mode is on. The allowlist governs the
# picker's 27, not literally every name the resolver returns.
known_builtin_toolsets:
  cli: &known [bfl, browser, clarify, code_execution, computer_use,
    context_engine, cronjob, delegation, discord, discord_admin, file,
    homeassistant, image_gen, memory, session_search, skills, spotify, stt,
    terminal, todo, tts, video, video_gen, vision, web, x_search, yuanbao]
  telegram: *known

# ── MCP ───────────────────────────────────────────────────────────────────
# Search comes from here rather than the built-in `web` toolset, so no Brave
# API key is needed in the data folder — the MCP server holds it.
#
# tools.include is an allowlist (exact names or globs). The server offers 8
# tools; one is enough to start. Add brave_news_search, brave_summarizer or
# brave_llm_context when you want them — cheaply. `hermes prompt-size` does
# not count MCP schemas, but they ARE sent on every request; what keeps them
# small is tools.tool_search (default "auto"), which hides every MCP tool
# behind three bridge tools plus a short listing. This one Brave tool costs
# 1,974 B on top of the core three; the other seven cost 634 B between them.
# Widen the include list before you reach for another built-in toolset.
#
# The URL differs per host and that is the ONLY MCP difference between the Mac
# and the NAS. See the README — the NAS cannot use the tailnet URL.
mcp_servers:
  brave-search:
    url: "${BRAVE_MCP_URL}"
    enabled: true
    tools:
      include: [brave_web_search]

memory:
  memory_enabled: true
  user_profile_enabled: true

compression:
  enabled: true
  threshold: 0.50
  target_ratio: 0.20
  protect_last_n: 20

updates:
  pre_update_backup: quick
  backup_keep: 5
