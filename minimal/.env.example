# Copy to ".env" next to docker-compose.yml, then edit. chmod 600 it.
#
# This file is the ONLY thing that differs between the Mac and the NAS.
# docker-compose.yml and data/config.yaml are byte-identical on both.

# --- Host user that owns the data folder ------------------------------------
# Run `id` on the host. Don't guess — a mismatch means the container cannot
# write to /opt/data and the gateway will not start.
#   NAS:  typically PUID=1026 PGID=100
#   Mac:  typically PUID=501  PGID=20  (cosmetic under Docker Desktop)
PUID=1026
PGID=100

# --- Where Hermes keeps its state -------------------------------------------
#   NAS:  /volume1/docker/hermes/data
#   Mac:  /Users/you/Development/hermes-docker/data
HERMES_DATA=/volume1/docker/hermes/data

TZ=UTC

# --- The model --------------------------------------------------------------
# Same on both hosts: the inference server is a third machine on the tailnet.
# Use the raw 100.x.y.z address — MagicDNS does not resolve inside Synology
# containers.
#
# CHECK THIS FIRST on the NAS. If `ip addr show tailscale0` says the device
# does not exist, the Tailscale package is in userspace mode: `tailscale ping`
# still works, but the kernel has no route to 100.x, so neither the host nor
# any container can reach it and curl just times out. Use the inference host's
# LAN address instead — and if it is on the same LAN as the NAS, that is the
# better route anyway.
LLM_BASE_URL=http://100.x.y.z:8080/v1
# llama.cpp ignores the model field when one model is loaded, so a short alias
# works there. vLLM and LiteLLM require the exact id from /v1/models.
LLM_MODEL=DeepSeek-V4-Flash-0731-UD-IQ2_M
# llama.cpp only checks this when started with --api-key. Keep it non-empty
# regardless — an empty key can trip client-side validation.
LLM_API_KEY=none

# --- The MCP server ---------------------------------------------------------
# THE one line that genuinely differs between hosts.
#
# On the NAS, where the MCP server is a container on this same host: use the
# container name and its INTERNAL port. The tailnet URL below CANNOT work from
# the NAS — `tailscale serve` only accepts connections from other tailnet
# peers, and a container is not one. See the README.
BRAVE_MCP_URL=http://brave-search-mcp:8080/mcp
#
# On the Mac, which genuinely is a different tailnet peer:
# BRAVE_MCP_URL=https://ds923.tail87aa42.ts.net:8422/mcp

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Setting this is what enables the platform.
# One token = one poller: starting a second gateway on the same token gets
# 409 Conflict from Telegram. Use a separate bot per host.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs. Ask @userinfobot for yours.
# Required — an agent reachable by strangers is an agent run by strangers.
TELEGRAM_ALLOWED_USERS=

# Default chat for unprompted messages. Optional until you enable cron.
TELEGRAM_HOME_CHANNEL=

# --- Resource ceilings ------------------------------------------------------
# Inference is remote, so Hermes itself needs very little. Raise MEM_LIMIT if
# you later enable the browser toolset, which runs Chromium in this container.
# Memory only — Synology can't cap CPU.
MEM_LIMIT=2G
